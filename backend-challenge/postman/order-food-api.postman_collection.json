		{
			"name": "Orders - Happy Path",
			"item": [
				{
					"name": "5 - Place Order (basic)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Has order ID', () => {",
									"    const r = pm.response.json();",
									"    pm.expect(r.id).to.be.a('string');",
									"    pm.expect(r.id.length).to.be.above(0);",
									"});",
									"pm.test('Correct items and currency', () => {",
									"    const r = pm.response.json();",
									"    pm.expect(r.items).to.have.length(1);",
									"    pm.expect(r.products).to.have.length(1);",
									"    pm.expect(r.total).to.eql(13);",
									"    pm.expect(r.discounts).to.eql(0);",
									"    pm.expect(r.currency).to.eql('USD');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "api_key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"items\":[{\"productId\":\"1\",\"quantity\":2}]}"
						},
						"url": "{{base_url}}/api/order"
					}
				},
				{
					"name": "6 - Place Order (HAPPYHRS coupon)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
