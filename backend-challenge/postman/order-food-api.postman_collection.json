									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Coupon applied', () => {",
									"    const r = pm.response.json();",
									"    pm.expect(r.couponCode).to.eql('HAPPYHRS');",
									"    pm.expect(r.discounts).to.be.above(0);",
									"    pm.expect(r.currency).to.eql('USD');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
