	"item": [
		{
			"name": "Products",
			"item": [
				{
					"name": "1 - List Products",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Returns array of 9', () => {",
									"    const data = pm.response.json();",
									"    pm.expect(data).to.be.an('array');",
									"    pm.expect(data).to.have.length(9);",
									"});",
									"pm.test('Products have required fields', () => {",
									"    const p = pm.response.json()[0];",
									"    pm.expect(p).to.have.all.keys('id','name','price','currency','category','image');",
									"    pm.expect(p.image).to.have.all.keys('thumbnail','mobile','tablet','desktop');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/product"
					}
				},
				{
					"name": "2 - Get Product (valid)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Correct product', () => {",
									"    const p = pm.response.json();",
									"    pm.expect(p.id).to.eql('1');",
									"    pm.expect(p.name).to.eql('Waffle with Berries');",
									"    pm.expect(p.price).to.eql(6.5);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/product/1"
					}
				},
				{
					"name": "3 - Get Product (not found)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 404', () => pm.response.to.have.status(404));",
									"pm.test('Error code', () => pm.expect(pm.response.json().code).to.eql('not_found'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/product/999"
					}
				},
				{
					"name": "4 - Get Product (invalid ID)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 400', () => pm.response.to.have.status(400));",
									"pm.test('Error code', () => pm.expect(pm.response.json().code).to.eql('bad_request'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/product/abc"
					}
				}
			]
